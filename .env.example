# GridWise environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
# Set to false to disable the LLM interpretation cache
APP_ENABLE_CACHE=true

# --- LLM Provider ----------------------------------------------------------
# One of: gemini | openai_compatible | mock
# Production deployments MUST NOT use "mock".
LLM_PROVIDER=gemini

# Google Gemini API key. Keep secret. Never commit.
# Paste the key from https://aistudio.google.com/apikey here.
GEMINI_API_KEY=

# (Optional) Override the Gemini endpoint. Defaults to Google's public
# Generative Language API host. Leave blank unless you proxy the API.
# Example: https://generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Gemini model identifier. Any current Gemini model works:
#   gemini-2.0-flash          (default; fast + cheap)
#   gemini-2.0-flash-lite
#   gemini-1.5-flash
#   gemini-1.5-pro
LLM_MODEL=gemini-2.0-flash

# Per-call timeout in seconds. Keep small to preserve p95 latency.
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# --- LLM interpretation cache ---------------------------------------------
LLM_CACHE_MAX_ENTRIES=256
LLM_CACHE_TTL_SECONDS=300

# --- Numerical tolerance ---------------------------------------------------
GRIDWISE_ABS_TOL=0.001
GRIDWISE_ACTION_TOL=0.0001
GRIDWISE_ACTION_SELECT_TOL=0.001
GRIDWISE_OUTPUT_PRECISION=4
GRIDWISE_ZERO_TOL=0.000001
GRIDWISE_SOLVER_TIMEOUT=25
