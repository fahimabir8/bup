# GridWise environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
# Set to false to disable the LLM interpretation cache
APP_ENABLE_CACHE=true

# --- LLM Provider ----------------------------------------------------------
# One of: openai_compatible | mock
# Production deployments MUST NOT use "mock".
LLM_PROVIDER=openai_compatible

# Endpoint for an OpenAI-compatible chat-completions API
# Examples:
#   https://api.openai.com/v1
#   http://localhost:11434/v1        (Ollama)
#   https://your-gateway.example.com/v1
LLM_BASE_URL=

# API key for the provider. Keep secret. Never commit.
LLM_API_KEY=

# Model identifier (e.g. "gpt-4o-mini", "llama3.1", "qwen2.5:7b-instruct")
LLM_MODEL=

# Per-call timeout in seconds. Keep small to preserve p95 latency.
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# --- LLM interpretation cache ---------------------------------------------
LLM_CACHE_MAX_ENTRIES=256
LLM_CACHE_TTL_SECONDS=300

# --- Numerical tolerance ---------------------------------------------------
GRIDWISE_ABS_TOL=0.001
GRIDWISE_ACTION_TOL=0.0001
GRIDWISE_ACTION_SELECT_TOL=0.001
GRIDWISE_OUTPUT_PRECISION=4
GRIDWISE_ZERO_TOL=0.000001
GRIDWISE_SOLVER_TIMEOUT=25
